# Copia este archivo a .env y completa los valores:  cp .env.example .env

# Dominio principal (sin https://). El API quedara en api.TUDOMINIO
DOMAIN=tudominio.com

# Email para los certificados TLS de Let's Encrypt (avisos de renovacion)
EMAIL=tu@email.com

# Base de datos Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga-y-aleatoria
POSTGRES_DB=app
