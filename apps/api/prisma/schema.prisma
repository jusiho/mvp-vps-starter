// Esquema de la base de datos (Prisma).
//
// Flujo de trabajo:
//   1. Edita este archivo (agrega o cambia modelos).
//   2. npm run db:migrate  -> crea la migracion en prisma/migrations y
//                             regenera el cliente tipado.
//   3. Commitea prisma/migrations: en produccion el contenedor del API las
//      aplica solo al arrancar (ver entrypoint.sh).
//
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de ejemplo: reemplazalo por los de tu negocio.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
