# "npm run setup" (en la raiz del repo) crea apps/api/.env automaticamente a
# partir del .env de la raiz. Este archivo es solo la referencia de su contenido.
# En produccion estas variables las define docker-compose.yml.

# Postgres local (lo levanta "npm run dev"). Usuario, clave, puerto y nombre
# de la base salen del .env de la raiz.
DATABASE_URL=postgresql://app:cambia-esto-por-una-clave-larga-y-aleatoria@localhost:5432/app

# Secreto con el que Better Auth firma las sesiones (lo genera "npm run setup").
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Opcionales (valores por defecto en src/main.ts y src/infra/auth/auth.ts)
# PORT=4000
# CORS_ORIGIN=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:4000
# COOKIE_DOMAIN=.tudominio.com   # solo en produccion
