# Copia este archivo a .env para desarrollo local:  cp .env.example .env
# (en produccion estas variables las define docker-compose.yml)

# Postgres local. Levantalo desde la raiz del repo con:  docker compose up -d db
# Usuario, clave y nombre de DB deben coincidir con el .env de la raiz.
DATABASE_URL=postgresql://app:cambia-esto-por-una-clave-larga-y-aleatoria@localhost:5432/app

# Opcionales (valores por defecto en src/main.ts)
# PORT=4000
# CORS_ORIGIN=http://localhost:3000
